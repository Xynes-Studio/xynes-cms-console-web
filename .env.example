# =============================================================================
# xynes-cms-console-web — local-dev env
# =============================================================================
#
# The FE Docker stack mounts xynes-front-end/infra/.env into every app
# container — that's the canonical FE env source. This file is for HOST-SIDE
# `pnpm dev` runs (when you run Next.js outside Docker) and is loaded by
# Next.js via .env.local.
#
# Canonical FE template:
#   ../infra/.env.example
# Canonical platform 3-level env model (Template / Local / Hosted):
#   ../../xynes/xynes-infra/ENV_GUIDE.md
# Hosted Dev/QA/Prod NEXT_PUBLIC_* values are merged into:
#   ../../xynes/xynes-infra/infra/release/templates/.env.<env>.template
#
# When running host-side `pnpm dev`:
#   cp .env.example .env.local
#   # then fill in real values from your local Supabase / dev infra
#
# `.env.local` is git-ignored. NEVER commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC (NEXT_PUBLIC_*) — derivable from infra/.env via with-env.mjs
# -----------------------------------------------------------------------------

# Supabase backend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Gateway URL the console talks to.
NEXT_PUBLIC_API_URL=http://localhost:4100

# This app's URL (for redirect callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth authority app (for cross-app redirects).
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3100

# Redirect allowlist as hostnames or host:port (no scheme/path).
NEXT_PUBLIC_ALLOWED_REDIRECT_DOMAINS=xynes.com,localhost:3000,localhost:3100

# Feature flag local-dev override (JSON). Empty in production — flips happen
# in PostHog admin against the gateway-side FeatureFlagService.
NEXT_PUBLIC_FEATURE_FLAGS_OVERRIDE=

# -----------------------------------------------------------------------------
# SERVER-ONLY (never expose to browser)
# -----------------------------------------------------------------------------

# Supabase Service Role Key — DANGEROUS. Only enable when needed.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
